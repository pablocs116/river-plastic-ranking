# Data — never commit raw or processed data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Results — figures and tables generated by notebooks
results/figures/*
results/tables/*
!results/figures/.gitkeep
!results/tables/.gitkeep

# Credentials
.env
.cdsapirc
credentials.json
token.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Environments
.venv/
env/
venv/
*.conda

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
